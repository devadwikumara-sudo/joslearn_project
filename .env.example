APP_NAME=JosBook
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOCALE=id
APP_URL=https://josbook.example.com

# Ubah menjadi local dan APP_DEBUG=true hanya untuk development lokal.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=josbook
DB_USERNAME=josbook_app
DB_PASSWORD=replace-with-secret-manager-value

LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Isi dengan nilai acak kuat melalui environment/secret manager server.
ADMIN_REGISTRATION_CODE=
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=Administrator
ADMIN_INITIAL_EMAIL=admin@example.test
ADMIN_INITIAL_PASSWORD=

# Origin frontend resmi, pisahkan beberapa origin dengan koma.
CORS_ALLOWED_ORIGINS=https://josbook.example.com
# Durasi token Sanctum dalam menit (43200 = 30 hari).
SANCTUM_EXPIRATION=43200

# Gunakan Google App Password, bukan kata sandi akun Gmail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=akun-pengirim@gmail.com
MAIL_PASSWORD=google-app-password
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"
